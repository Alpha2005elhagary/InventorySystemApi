    {
      "name": "5. Stock Movements (Database Entity: StockTransactions)",
      "item": [
        {
          "name": "Get Stock Transactions (All / Paged)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock/transactions?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "transactions"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Returns stock audit ledger entries stored in the database."
          },
          "response": []
        },
        {
          "name": "Filter Transactions by Product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock/transactions?productId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "transactions"],
              "query": [
                {
                  "key": "productId",
                  "value": "1"
                }
              ]
            },
            "description": "Filters transactions for a specific product ID."
          },
          "response": []
        },
        {
          "name": "Stock In (Receive Inventory)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 25,\n  \"notes\": \"Received supplier shipment PO-8821\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock/in",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "in"]
            },
            "description": "Increases product quantity and writes audit ledger entry."
          },
          "response": []
        },
        {
          "name": "Stock Out (Release Inventory)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2,\n  \"notes\": \"Direct sales order #SO-9912\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock/out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "out"]
            },
            "description": "Decreases product quantity (with insufficient stock guard) and records audit ledger entry."
          },
          "response": []
        }
